<Window x:Class="PromptQueue.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfh="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="zProject"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480"
        WindowStyle="SingleBorderWindow"
        Background="#0c0c0c">

  <!-- The entire UI is rendered in WebView2 via zUI.
       WindowsFormsHost gives us a WinForms WebView2 control in a WPF window. -->
  <wfh:WindowsFormsHost x:Name="WebViewHost">
    <wf:Panel x:Name="WebViewPanel" />
  </wfh:WindowsFormsHost>

</Window>
