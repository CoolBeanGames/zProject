<Window x:Class="PromptQueue.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PromptQueue.App"
        xmlns:vm="clr-namespace:PromptQueue.App.ViewModels"
        Title="zProject" Height="720" Width="1120"
        MinHeight="480" MinWidth="800"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <app:BoolToStrikethroughConverter x:Key="Strike"/>
        <app:BoolToVisibilityConverter x:Key="BoolVis"/>
        <app:StringToVisibilityConverter x:Key="StrVis"/>
        <app:SingleLinePreviewConverter x:Key="OneLine"/>
        <app:AllEmptyToVisibilityConverter x:Key="AllEmpty"/>
        <app:BoolToShowHideConverter x:Key="ShowHide"/>
        <app:CheckGlyphConverter x:Key="CheckGlyph"/>
        <app:TagColorConverter x:Key="TagColor"/>
        <app:TagListConverter x:Key="TagList"/>
        <app:LockGlyphConverter x:Key="LockGlyph"/>

        <!-- ===================== TEXT EDITOR OVERLAY ===================== -->
        <DataTemplate DataType="{x:Type vm:TextEditorViewModel}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Width="760" MaxHeight="560" Margin="24">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageHeading}"
                               Text="{Binding Title}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SecondaryText}"
                               Margin="0,2,0,12" Text="{Binding Subtitle}"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" MinWidth="72" Command="{Binding CancelCommand}"/>
                        <Button Content="Save" MinWidth="72" Margin="8,0,0,0"
                                Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                    <TextBox Style="{StaticResource EditorTextBox}" MinHeight="280"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== TASK FORM OVERLAY ===================== -->
        <DataTemplate DataType="{x:Type vm:TaskFormViewModel}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Width="640" MaxHeight="620" Margin="24">
                <DockPanel Margin="16">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageHeading}" Text="{Binding Title}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0">
                                <Run Text="ID"/><Run Text="  "/><Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <CheckBox Content="Commit" VerticalAlignment="Center"
                                      IsChecked="{Binding Commit}"
                                      ToolTip="Commit and push the project to GitHub once this task is done"/>
                            <CheckBox Content="Build" VerticalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding Build}"
                                      ToolTip="Build the project to builds/debug once this task is done"/>
                            <CheckBox Content="Release" VerticalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding Release}"
                                      ToolTip="Produce a release build (builds/release) once this task is done"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" MinWidth="72" Command="{Binding CancelCommand}"/>
                        <Button Content="Save" MinWidth="72" Margin="8,0,0,0"
                                Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name (optional — defaults to the ID)"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Prompt" Margin="0,12,0,3"/>
                            <TextBox Style="{StaticResource EditorTextBox}" Height="120"
                                     AcceptsTab="False"
                                     Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Requirements" Margin="0,12,0,3"/>
                            <TextBox Style="{StaticResource EditorTextBox}" Height="90"
                                     AcceptsTab="False"
                                     Text="{Binding Requirements, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Subtasks (ZP-22) -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Subtasks" Margin="0,12,0,3"/>
                            <ItemsControl ItemsSource="{Binding Subtasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                      IsChecked="{Binding Done}" Margin="0,0,6,0"/>
                                            <Button DockPanel.Dock="Right" Content="✕" Width="22" Padding="0"
                                                    Style="{StaticResource ToolbarButton}"
                                                    ToolTip="Remove subtask"
                                                    Command="{Binding DataContext.RemoveSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,3,0,0">
                                <Button DockPanel.Dock="Right" Content="Add" MinWidth="48" Margin="6,0,0,0"
                                        Command="{Binding AddSubtaskCommand}"/>
                                <TextBox Text="{Binding NewSubtask, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="NewSubtask_KeyDown"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox Content="In progress" IsChecked="{Binding InProgress}"/>
                                <CheckBox Content="Done" Margin="16,0,0,0" IsChecked="{Binding Done}"/>
                                <CheckBox Content="Bug" Margin="16,0,0,0" IsChecked="{Binding Bug}"
                                          ToolTip="Flag as a bug — bugs sort to the top of the list and the xml file"/>
                                <CheckBox Content="Locked" Margin="16,0,0,0" IsChecked="{Binding Locked}"
                                          ToolTip="Locked — greyed out and ignored by an agent"/>
                                <CheckBox Content="Archived" Margin="16,0,0,0" IsChecked="{Binding Archived}"
                                          ToolTip="Archived — still shown here, ignored by an agent"/>
                            </StackPanel>

                            <!-- Blocked by (ZP-31) -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Blocked by (task ID)" Margin="0,12,0,3"/>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                      ItemsSource="{Binding BlockCandidates}"
                                      Text="{Binding BlockedBy, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="An agent completes this task's blocker first, or skips them both"/>

                            <!-- Dates (ZP-32) -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Date started"/>
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right" Width="60" Margin="6,0,0,0"
                                                 Text="{Binding StartTimePart, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Time, HH:mm"/>
                                        <DatePicker SelectedDate="{Binding StartDatePart}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Due"/>
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right" Width="60" Margin="6,0,0,0"
                                                 Text="{Binding DueTimePart, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Time, HH:mm"/>
                                        <DatePicker SelectedDate="{Binding DueDatePart}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tags (comma separated)" Margin="0,12,0,3"/>
                            <TextBox Text="{Binding TagText, UpdateSourceTrigger=PropertyChanged}"/>
                            <ItemsControl ItemsSource="{Binding TagText, Converter={StaticResource TagList}}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusChip}" Padding="5,1"
                                                Background="{Binding Converter={StaticResource TagColor}}"
                                                BorderBrush="{Binding Converter={StaticResource TagColor}, ConverterParameter=border}">
                                            <TextBlock Text="{Binding}" Style="{StaticResource StatusChipText}"
                                                       Foreground="{Binding Converter={StaticResource TagColor}, ConverterParameter=text}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Agent-written sections: shown only when already populated (ZP-6) -->
                            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Error (agent)" Margin="0,12,0,3"
                                           Foreground="#B03030"/>
                                <CheckBox Content="Error flag set" IsChecked="{Binding Error}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource EditorTextBox}" Height="70"
                                         Text="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Notes (agent)" Margin="0,12,0,3"/>
                                <TextBox Style="{StaticResource EditorTextBox}" Height="80"
                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasFilesChanged, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Files changed (agent)" Margin="0,12,0,3"/>
                                <TextBox Style="{StaticResource EditorTextBox}" Height="80"
                                         Text="{Binding FilesChanged, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== MENU ===================== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project…" Command="{Binding NewProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Save _Current Project" Command="{Binding SaveCurrentCommand}"/>
                <MenuItem Header="_Save All" Command="{Binding SaveAllCommand}"/>
                <MenuItem Header="_Reload Project from Disk" Command="{Binding ReloadProjectCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Add _Task" Command="{Binding AddTaskCommand}"/>
            </MenuItem>
            <MenuItem Header="_Globals">
                <MenuItem Header="Global _Design" Command="{Binding EditGlobalDesignCommand}"/>
                <MenuItem Header="Global _Instructions" Command="{Binding EditGlobalInstructionsCommand}"/>
                <MenuItem Header="Global _Prompt" Command="{Binding EditGlobalPromptCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ===================== GLOBAL TOOLBAR ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,5">
                <TextBlock Text="GLOBAL" VerticalAlignment="Center" Margin="2,0,10,0"
                           Style="{StaticResource SectionHeading}"/>
                <Button Content="Design" Style="{StaticResource ToolbarButton}"
                        Command="{Binding EditGlobalDesignCommand}"/>
                <Button Content="Instructions" Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                        Command="{Binding EditGlobalInstructionsCommand}"/>
                <Button Content="Prompt" Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                        Command="{Binding EditGlobalPromptCommand}"/>
            </StackPanel>
        </Border>

        <!-- ===================== STATUS BAR ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SecondarySurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Margin="10,4" Style="{StaticResource SecondaryText}"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ===================== BODY ===================== -->
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <DockPanel Grid.Column="0" Background="{StaticResource AppBackgroundBrush}">
                    <TextBlock DockPanel.Dock="Top" Text="PROJECTS" Margin="12,10,12,6"
                               Style="{StaticResource SectionHeading}"/>
                    <Button DockPanel.Dock="Bottom" Content="+ New Project" Margin="8,6,8,10"
                            HorizontalContentAlignment="Left" Padding="8,4"
                            Command="{Binding NewProjectCommand}"/>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource HSeparatorBorder}" Margin="0"/>
                    <ListBox x:Name="ProjectList" Style="{StaticResource SidebarList}"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             ItemsSource="{Binding Workspace.Projects}"
                             SelectedItem="{Binding SelectedProject}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Directory}" Style="{StaticResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- MAIN PANEL -->
                <Grid Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <TextBlock Text="No project selected" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="Choose a project on the left, or create one with + New Project."
                                   Margin="0,6,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <!-- Project view -->
                    <DockPanel Visibility="{Binding DataContext.HasSelectedProject, Converter={StaticResource BoolVis}, RelativeSource={RelativeSource AncestorType=Window}}"
                               DataContext="{Binding SelectedProject}">
                        <!-- Header -->
                        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
                            <TextBlock Style="{StaticResource PageHeading}" Text="{Binding Name}"/>
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                                       Text="{Binding Directory}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Add Task" Style="{StaticResource AccentButton}" MinWidth="80"
                                        Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <ComboBox Width="200" Margin="6,0,0,0" IsEditable="True" IsTextSearchEnabled="True"
                                          VerticalContentAlignment="Center"
                                          ToolTip="Tags for new tasks (comma separated) — existing tags autocomplete"
                                          ItemsSource="{Binding DataContext.KnownTags, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding DataContext.NewTaskTagText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2"/>
                                <TextBlock Text="LOCAL" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Style="{StaticResource SectionHeading}"/>
                                <Button Content="Design" Style="{StaticResource ToolbarButton}"
                                        Command="{Binding DataContext.EditLocalDesignCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Instructions" Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.EditLocalInstructionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Prompt" Style="{StaticResource ToolbarButton}" Margin="4,0,0,0"
                                        Command="{Binding DataContext.EditLocalPromptCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2"/>
                                <Button Content="Reload" Style="{StaticResource ToolbarButton}"
                                        Command="{Binding DataContext.ReloadProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <Border Style="{StaticResource HSeparatorBorder}" Margin="0,12,0,0"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource SectionHeading}" Margin="4,6"/>
                                <TextBlock Grid.Column="3" Text="PROMPT / REQUIREMENTS" Style="{StaticResource SectionHeading}" Margin="4,6"/>
                                <TextBlock Grid.Column="4" Text="DRAG A ROW TO REORDER" Style="{StaticResource SectionHeading}" Margin="4,6"/>
                            </Grid>
                            <Border Style="{StaticResource HSeparatorBorder}"/>
                        </StackPanel>

                        <!-- Empty task list -->
                        <StackPanel DockPanel.Dock="Top" Margin="16,20"
                                    Visibility="{Binding Tasks.Count, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <TextBlock Text="No tasks yet" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="Use Add Task to queue the first prompt." Margin="0,6,0,0"
                                       Style="{StaticResource SecondaryText}"/>
                        </StackPanel>

                        <!-- Task list -->
                        <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent"
                                 Margin="8,0,8,8"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="False"
                                 ItemsSource="{Binding DataContext.TasksView, RelativeSource={RelativeSource AncestorType=Window}}"
                                 KeyboardNavigation.DirectionalNavigation="Cycle">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <!-- section divider -->
                                                            <Border x:Name="Divider"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="0,1,0,0"
                                                                    Margin="0,8,0,3" Padding="2,5,2,3">
                                                                <DockPanel>
                                                                    <Button x:Name="CollapseBtn" DockPanel.Dock="Right"
                                                                            Style="{StaticResource ToolbarButton}"
                                                                            AutomationProperties.AutomationId="CollapseCompletedBtn"
                                                                            Visibility="Collapsed"
                                                                            Command="{Binding DataContext.ToggleCompletedCollapsedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            Content="{Binding DataContext.CompletedCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ShowHide}}"/>
                                                                    <TextBlock x:Name="SectionLabel"
                                                                               Style="{StaticResource SectionHeading}"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding Name}"/>
                                                                    <TextBlock Style="{StaticResource SectionHeading}"
                                                                               VerticalAlignment="Center" Opacity="0.7"
                                                                               Text="{Binding ItemCount, StringFormat=' ({0})'}"/>
                                                                </DockPanel>
                                                            </Border>
                                                            <ItemsPresenter x:Name="Items"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Bugs">
                                                                <Setter TargetName="SectionLabel" Property="Foreground"
                                                                        Value="{StaticResource BugTextBrush}"/>
                                                                <Setter TargetName="Divider" Property="Background"
                                                                        Value="{StaticResource BugSurfaceBrush}"/>
                                                                <Setter TargetName="Divider" Property="BorderBrush"
                                                                        Value="{StaticResource BugBorderBrush}"/>
                                                                <Setter TargetName="Divider" Property="BorderThickness"
                                                                        Value="0,2,0,1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Needs attention">
                                                                <Setter TargetName="SectionLabel" Property="Foreground"
                                                                        Value="{StaticResource ErrorTextBrush}"/>
                                                                <Setter TargetName="Divider" Property="Background"
                                                                        Value="{StaticResource ErrorSurfaceBrush}"/>
                                                                <Setter TargetName="Divider" Property="BorderBrush"
                                                                        Value="{StaticResource ErrorBorderBrush}"/>
                                                                <Setter TargetName="Divider" Property="BorderThickness"
                                                                        Value="0,2,0,1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Completed">
                                                                <Setter TargetName="CollapseBtn" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SectionLabel" Property="Foreground"
                                                                        Value="{StaticResource DoneTextBrush}"/>
                                                                <Setter TargetName="Divider" Property="Background"
                                                                        Value="{StaticResource DoneSurfaceBrush}"/>
                                                                <Setter TargetName="Divider" Property="BorderBrush"
                                                                        Value="{StaticResource DoneBorderBrush}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Name}" Value="Completed"/>
                                                                    <Condition Binding="{Binding DataContext.CompletedCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TaskItem_PreviewMouseLeftButtonDown"/>
                                    <EventSetter Event="MouseMove" Handler="TaskItem_MouseMove"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="TaskItem_MouseDoubleClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="2" Padding="6,5"
                                            ToolTipService.ShowDuration="30000"
                                            ToolTipService.InitialShowDelay="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <!-- done = pale green -->
                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DoneSurfaceBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource DoneBorderBrush}"/>
                                                    </DataTrigger>
                                                    <!-- unfinished error = pale red -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Error}" Value="True"/>
                                                            <Condition Binding="{Binding Done}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}"/>
                                                    </MultiDataTrigger>
                                                    <!-- unfinished bug = pale purple (wins over error) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Bug}" Value="True"/>
                                                            <Condition Binding="{Binding Done}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BugSurfaceBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BugBorderBrush}"/>
                                                    </MultiDataTrigger>
                                                    <!-- locked = grey (wins over everything; an agent ignores it) -->
                                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource LockedSurfaceBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource LockedBorderBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ToolTip>
                                            <ToolTip MaxWidth="420">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>

                                                    <StackPanel Margin="0,4,0,0"
                                                                Visibility="{Binding ErrorMessage, Converter={StaticResource StrVis}}">
                                                        <TextBlock Text="Error" FontWeight="SemiBold"
                                                                   Foreground="#B03030"/>
                                                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,4,0,0"
                                                                Visibility="{Binding Notes, Converter={StaticResource StrVis}}">
                                                        <TextBlock Text="Notes (agent)" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,4,0,0"
                                                                Visibility="{Binding FilesChanged, Converter={StaticResource StrVis}}">
                                                        <TextBlock Text="Files changed" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding FilesChanged}" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,4,0,0"
                                                                Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVis}}">
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="Subtasks"/><Run Text=" "/><Run Text="{Binding SubtaskProgress, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <ItemsControl ItemsSource="{Binding Subtasks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock TextWrapping="Wrap">
                                                                        <Run Text="{Binding Done, Converter={StaticResource CheckGlyph}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <TextBlock Text="No agent notes, errors, or file changes recorded yet."
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Margin="0,4,0,0">
                                                        <TextBlock.Visibility>
                                                            <MultiBinding Converter="{StaticResource AllEmpty}">
                                                                <Binding Path="ErrorMessage"/>
                                                                <Binding Path="Notes"/>
                                                                <Binding Path="FilesChanged"/>
                                                                <Binding Path="SubtaskProgress"/>
                                                            </MultiBinding>
                                                        </TextBlock.Visibility>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- drag handle (click and drag anywhere on the row to reorder) -->
                                            <TextBlock Grid.Column="0" Text="⠿" FontSize="14" VerticalAlignment="Top"
                                                       Margin="2,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                                       Cursor="SizeNS" ToolTip="Drag to reorder"/>

                                            <!-- done -->
                                            <CheckBox Grid.Column="1" VerticalAlignment="Top" Margin="6,2,0,0"
                                                      IsChecked="{Binding Done}"
                                                      ToolTip="Done"
                                                      Checked="TaskDone_Changed" Unchecked="TaskDone_Changed"/>

                                            <!-- id -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="4,1,0,0">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold"
                                                           TextDecorations="{Binding Done, Converter={StaticResource Strike}}"/>
                                                <TextBlock Text="in progress" Style="{StaticResource SecondaryText}"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="10"
                                                           Visibility="{Binding InProgress, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="10"
                                                           Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVis}}">
                                                    <Run Text="☑"/><Run Text=" "/><Run Text="{Binding SubtaskProgress, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- content -->
                                            <StackPanel Grid.Column="3" Margin="4,1,8,0">
                                                <TextBlock Text="{Binding Prompt, Converter={StaticResource OneLine}}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap"
                                                           TextDecorations="{Binding Done, Converter={StaticResource Strike}}"/>
                                                <TextBlock Text="{Binding Requirements, Converter={StaticResource OneLine}}"
                                                           Style="{StaticResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Requirements, Converter={StaticResource StrVis}}"
                                                           Margin="0,2,0,0"/>

                                                <!-- blocked by (ZP-31) -->
                                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                                                           FontStyle="Italic"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsBlocked, Converter={StaticResource BoolVis}}">
                                                    <Run Text="⛔ blocked by "/><Run Text="{Binding BlockedByLabel, Mode=OneWay}"/>
                                                </TextBlock>

                                                <!-- dates (ZP-32) -->
                                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasDates, Converter={StaticResource BoolVis}}"
                                                           Text="{Binding DatesSummary, Mode=OneWay}"/>

                                                <!-- at-a-glance status chips (ZP-25) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource AllEmpty}" ConverterParameter="invert">
                                                            <Binding Path="Bug"/>
                                                            <Binding Path="Error"/>
                                                            <Binding Path="Commit"/>
                                                            <Binding Path="Build"/>
                                                            <Binding Path="Release"/>
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    <Border Style="{StaticResource StatusChip}"
                                                            Background="{StaticResource BugSurfaceBrush}"
                                                            BorderBrush="{StaticResource BugBorderBrush}"
                                                            Visibility="{Binding Bug, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="BUG" Style="{StaticResource StatusChipText}"
                                                                   Foreground="{StaticResource BugTextBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource StatusChip}"
                                                            Background="{StaticResource ErrorSurfaceBrush}"
                                                            BorderBrush="{StaticResource ErrorBorderBrush}"
                                                            Visibility="{Binding Error, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="ERROR" Style="{StaticResource StatusChipText}"
                                                                   Foreground="{StaticResource ErrorTextBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource StatusChip}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            Visibility="{Binding Commit, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="COMMIT" Style="{StaticResource StatusChipText}"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource StatusChip}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            Visibility="{Binding Build, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="BUILD" Style="{StaticResource StatusChipText}"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource StatusChip}"
                                                            BorderBrush="{StaticResource AccentBrush}"
                                                            Visibility="{Binding Release, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="RELEASE" Style="{StaticResource StatusChipText}"
                                                                   Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- colour-coded tag chips (ZP-26) -->
                                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,3,0,0"
                                                              Visibility="{Binding TagText, Converter={StaticResource StrVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource StatusChip}" Padding="5,1"
                                                                    Background="{Binding Converter={StaticResource TagColor}}"
                                                                    BorderBrush="{Binding Converter={StaticResource TagColor}, ConverterParameter=border}">
                                                                <TextBlock Text="{Binding}" Style="{StaticResource StatusChipText}"
                                                                           Foreground="{Binding Converter={StaticResource TagColor}, ConverterParameter=text}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- inline subtask checklist (ZP-22) -->
                                                <ItemsControl ItemsSource="{Binding Subtasks}" Margin="0,3,0,0"
                                                              Visibility="{Binding HasSubtasks, Converter={StaticResource BoolVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Margin="0,1" FontSize="11"
                                                                      Content="{Binding Text}"
                                                                      IsChecked="{Binding Done}"
                                                                      Checked="Subtask_Changed" Unchecked="Subtask_Changed"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- actions -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource ToolbarButton}" Width="24" Padding="0"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                        Content="{Binding Locked, Converter={StaticResource LockGlyph}}"
                                                        ToolTip="Lock / unlock — a locked task is greyed out and ignored by an agent"
                                                        Command="{Binding DataContext.ToggleTaskLockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Edit" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                                                        Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Delete" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ===================== OVERLAY LAYER ===================== -->
            <Border Background="#66000000"
                    Visibility="{Binding HasOverlay, Converter={StaticResource BoolVis}}">
                <ContentControl Content="{Binding Overlay}" HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
